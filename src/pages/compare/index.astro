---
import BaseLayout from "../../layouts/BaseLayout.astro";

type ComparisonFamily =
  | "radio"
  | "reticulum"
  | "external"
  | "applications";

interface ComparisonItem {
  name: string;
  category: string;
  family: ComparisonFamily;
  description: string;
  distinction: string;
  href: string;
}

interface ComparisonFamilyDefinition {
  id: ComparisonFamily;
  kicker: string;
  title: string;
  description: string;
  grid: string;
}

const comparisons: ComparisonItem[] = [
  {
    name: "Meshtastic",
    category: "LoRa mesh communication",
    family: "radio",
    description:
      "Low-power, off-grid LoRa mesh communication for portable devices, messaging, telemetry, and location.",
    distinction:
      "Meshtastic is strongly focused on LoRa mesh communication. RelayHub is intended as broader household and community infrastructure in which radio is one possible transport.",
    href: "/compare/meshtastic",
  },
  {
    name: "MeshCore",
    category: "LoRa mesh communication",
    family: "radio",
    description:
      "A decentralised LoRa communications ecosystem with companion nodes, repeaters, standalone devices, and increasingly capable mesh infrastructure tooling.",
    distinction:
      "MeshCore is focused on LoRa mesh communication and radio infrastructure. RelayHub extends into persistent household appliances, multiple transport classes, recovery, policy governance, and broader community infrastructure.",
    href: "/compare/meshcore",
  },
  {
    name: "LoRaWAN",
    category: "Low-power wide-area IoT",
    family: "radio",
    description:
      "A standardised low-power wide-area networking architecture for sensors, meters, trackers, actuators, and other constrained devices using LoRa radio and gateway-to-server infrastructure.",
    distinction:
      "LoRaWAN is primarily designed for IoT telemetry through gateways and network servers. RelayHub is intended for resilient human and community infrastructure across multiple transport classes.",
    href: "/compare/lorawan",
  },
  {
    name: "Amateur Radio",
    category: "Licensed radio communication",
    family: "radio",
    description:
      "A long-established radio service supporting communication, experimentation, repeaters, digital modes, field operation, and technical learning under jurisdiction-specific rules.",
    distinction:
      "Amateur radio gives qualified operators substantial radio capability. RelayHub targets appliance-style infrastructure for ordinary users and treats legal radio permission as a separate runtime gate.",
    href: "/compare/amateur-radio",
  },
  {
    name: "Reticulum ecosystem",
    category: "Resilient networking and applications",
    family: "reticulum",
    description:
      "Reticulum and applications such as Sideband, Nomad Network, and other compatible tools already provide resilient communication capabilities.",
    distinction:
      "RelayHub uses Reticulum rather than competing with it. RelayHub adds an appliance, policy, recovery, validation, and community infrastructure layer around the communications substrate.",
    href: "/compare/reticulum",
  },
  {
    name: "Sideband",
    category: "Reticulum messaging and telephony",
    family: "reticulum",
    description:
      "A graphical Reticulum client for LXMF messaging, LXST voice, files, telemetry, mapping, remote interaction, and communication across multiple Reticulum transports.",
    distinction:
      "Sideband already provides much of the user-facing Reticulum communication experience. RelayHub focuses on the surrounding appliance, infrastructure, policy, recovery, and household-management layer.",
    href: "/compare/sideband",
  },
  {
    name: "Nomad Network",
    category: "Reticulum messaging and information services",
    family: "reticulum",
    description:
      "A Reticulum and LXMF application providing messaging, delayed delivery, hosted pages and files, distributed message storage, and low-bandwidth text-based network interaction.",
    distinction:
      "Nomad Network already provides resilient application services over Reticulum. RelayHub is intended to provide the managed appliance and infrastructure environment in which such services may operate.",
    href: "/compare/nomad-network",
  },
  {
    name: "Cellular push-to-talk",
    category: "Carrier-assisted communication",
    family: "external",
    description:
      "Products such as Echo Radio and Poclink provide simple push-to-talk communication, commonly using cellular infrastructure and, in some products, additional direct-radio capability.",
    distinction:
      "Cellular PTT can provide extremely simple wide-area voice. RelayHub is designed around locally controlled infrastructure that can remain useful when external connectivity is unavailable or unsuitable.",
    href: "/compare/cellular-ptt",
  },
  {
    name: "Satellite communicators",
    category: "Remote-area communication",
    family: "external",
    description:
      "Satellite communicators provide messaging and other supported services beyond terrestrial cellular coverage.",
    distinction:
      "Satellite solves a failure domain that local terrestrial infrastructure cannot. RelayHub and satellite communication are potentially complementary rather than substitutes.",
    href: "/compare/satellite",
  },
  {
    name: "Signal",
    category: "Private internet messaging",
    family: "applications",
    description:
      "A mature end-to-end encrypted messaging and calling application designed to make private communication straightforward for ordinary users.",
    distinction:
      "Signal provides excellent private communication over conventional internet connectivity. RelayHub addresses the underlying infrastructure problem, including local, radio-assisted and other validated paths when internet-dependent applications cannot reach their normal services.",
    href: "/compare/signal",
  },
  {
    name: "Session",
    category: "Decentralised private messaging",
    family: "applications",
    description:
      "A decentralised encrypted messenger using cryptographic Account IDs, onion-routed messaging and distributed message storage across the Session Network.",
    distinction:
      "Session decentralises messaging infrastructure across its own network. RelayHub instead aims to provide locally operated communications infrastructure across heterogeneous Reticulum transports.",
    href: "/compare/session",
  },
  {
    name: "Briar",
    category: "Peer-to-peer messaging",
    family: "applications",
    description:
      "A decentralised messaging application designed to communicate without relying on central messaging servers and to support nearby offline communication.",
    distinction:
      "Briar focuses primarily on resilient communication between user devices. RelayHub is intended to provide persistent household and community infrastructure beyond a single application.",
    href: "/compare/briar",
  },
  {
    name: "Conventional internet platforms",
    category: "Cloud and centralised services",
    family: "applications",
    description:
      "Mainstream messaging, coordination, marketplace, knowledge, and community platforms generally provide excellent usability while their required infrastructure remains reachable.",
    distinction:
      "RelayHub is not intended to replace the internet. It is intended to reduce total dependence on centralised, continuously reachable services for useful local operation.",
    href: "/compare/conventional-platforms",
  },
];

const families: ComparisonFamilyDefinition[] = [
  {
    id: "radio",
    kicker: "Radio & LoRa",
    title: "Radio systems and low-power networks",
    description:
      "These comparisons look at systems where radio is central to the architecture — from portable LoRa meshes and IoT networks to licensed amateur-radio infrastructure.",
    grid: "rh-grid-2",
  },
  {
    id: "reticulum",
    kicker: "Reticulum ecosystem",
    title: "The technologies RelayHub is built alongside",
    description:
      "These are especially important comparisons because RelayHub uses Reticulum rather than replacing it. Existing Reticulum applications may provide capabilities that RelayHub should integrate with instead of rebuilding.",
    grid: "rh-grid-3",
  },
  {
    id: "external",
    kicker: "External infrastructure",
    title: "Wide-area services beyond local infrastructure",
    description:
      "Carrier and satellite systems can provide reach that locally operated infrastructure cannot reproduce. The important question is where those services complement RelayHub and where dependency on external infrastructure matters.",
    grid: "rh-grid-2",
  },
  {
    id: "applications",
    kicker: "Applications & internet platforms",
    title: "Software services and conventional online platforms",
    description:
      "These comparisons separate applications from the infrastructure underneath them, including private internet messaging, decentralised messaging, peer-to-peer communication and the conventional online platforms people already use every day.",
    grid: "rh-grid-2",
  },
];

const principles = [
  {
    title: "No fake winners",
    text:
      "A technology that is better for a particular job should be described as better for that job. RelayHub does not need to win every comparison.",
  },
  {
    title: "Different categories matter",
    text:
      "A LoRa mesh, IoT network, satellite communicator, mobile application, cellular radio, amateur-radio system, Reticulum application, and household infrastructure node are not equivalent products merely because they can all carry data or messages.",
  },
  {
    title: "Current capability only",
    text:
      "Planned RelayHub capability must not be presented as product-supported capability until implementation and validation gates have been passed.",
  },
  {
    title: "Complement before replace",
    text:
      "RelayHub should coexist with useful infrastructure and technologies wherever practical instead of demanding that users abandon systems that already work.",
  },
];

const getFamilyComparisons = (family: ComparisonFamily) =>
  comparisons.filter((item) => item.family === family);
---

<BaseLayout
  title="Compare RelayHub"
  description="Compare RelayHub with Meshtastic, MeshCore, LoRaWAN, amateur radio, Reticulum, Sideband, Nomad Network, cellular push-to-talk, satellite communicators, Signal, Session, Briar, and conventional internet platforms."
>
  <section class="rh-hero">
    <div class="rh-container rh-hero-inner">
      <p class="rh-eyebrow">Compare RelayHub</p>

      <h1 class="rh-title">
        Different tools solve different problems.
      </h1>

      <p class="rh-subtitle">
        RelayHub is not another radio, another messaging app, or an attempt to
        replace every communications technology. Compare what each approach is
        actually designed to do, where it works well, and where its dependencies
        and limits differ.
      </p>

      <div class="rh-actions">
        <a class="rh-button rh-button-primary" href="#technologies">
          Explore comparisons
        </a>

        <a class="rh-button rh-button-secondary" href="/how-it-works">
          How RelayHub works
        </a>
      </div>
    </div>
  </section>

  <section class="rh-section" id="technologies">
    <div class="rh-container">
      <p class="rh-kicker">Technology comparisons</p>

      <h2 class="rh-section-title">
        Start with the problem, not the product.
      </h2>

      <p class="rh-section-lead">
        These technologies overlap in places, but they are not interchangeable.
        The useful question is not which one wins. It is which architecture fits
        the people, environment, failure conditions, and operational requirements.
      </p>

      <div class="rh-grid rh-grid-2" style="margin-top: var(--space-10);">
        {families.map((family) => (
          <a
            class="rh-card"
            href={`#${family.id}`}
            style="text-decoration: none;"
          >
            <p class="rh-kicker">{family.kicker}</p>
            <h3 class="rh-card-title">{family.title}</h3>
            <p class="rh-card-text">{family.description}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  {families.map((family, index) => {
    const items = getFamilyComparisons(family.id);

    return (
      <section
        class={`rh-section ${index % 2 === 0 ? "rh-bg-soft" : ""}`}
        id={family.id}
      >
        <div class="rh-container">
          <p class="rh-kicker">{family.kicker}</p>

          <h2 class="rh-section-title">
            {family.title}
          </h2>

          <p class="rh-section-lead">
            {family.description}
          </p>

          <div
            class={`rh-grid ${family.grid}`}
            style="margin-top: var(--space-10);"
          >
            {items.map((item) => (
              <article class="rh-card">
                <p class="rh-kicker">{item.category}</p>

                <h3 class="rh-card-title">{item.name}</h3>

                <p class="rh-card-text">
                  {item.description}
                </p>

                <p
                  class="rh-card-text"
                  style="margin-top: var(--space-5);"
                >
                  <strong>Key distinction:</strong> {item.distinction}
                </p>

                <div
                  class="rh-actions"
                  style="margin-top: var(--space-6);"
                >
                  <a
                    class="rh-button rh-button-secondary"
                    href={item.href}
                  >
                    Compare
                  </a>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>
    );
  })}

  <section class="rh-section rh-dark">
    <div class="rh-container">
      <p class="rh-kicker">The central distinction</p>

      <h2 class="rh-section-title">
        RelayHub is infrastructure, not just a communications device.
      </h2>

      <p class="rh-section-lead">
        RelayHub is being designed as an ecosystem of interoperable node classes
        for households, field use, and community infrastructure. Reticulum provides
        the communications substrate. RelayOS adds appliance behaviour, capability
        awareness, policy, recovery, observability, updates, and local management.
      </p>

      <div class="rh-grid rh-grid-3" style="margin-top: var(--space-10);">
        <article class="rh-card rh-card-dark">
          <h3 class="rh-card-title">Multiple hardware classes</h3>

          <p class="rh-card-text">
            Small radio nodes, household appliances, stronger home nodes, and
            infrastructure nodes have different capability ceilings and roles.
          </p>
        </article>

        <article class="rh-card rh-card-dark">
          <h3 class="rh-card-title">Multiple operating conditions</h3>

          <p class="rh-card-text">
            Local-only, internet-assisted, offline, radio-assisted, degraded,
            household, field, and community infrastructure operation are treated
            as normal operating conditions rather than one universal mode.
          </p>
        </article>

        <article class="rh-card rh-card-dark">
          <h3 class="rh-card-title">Recovery is part of the product</h3>

          <p class="rh-card-text">
            Rollback, identity preservation, degraded boot behaviour, offline
            recovery, safe reset, and understandable recovery access are
            architectural requirements rather than afterthoughts.
          </p>
        </article>
      </div>
    </div>
  </section>

  <section class="rh-section">
    <div class="rh-container">
      <p class="rh-kicker">How we compare</p>

      <h2 class="rh-section-title">
        Comparisons should be useful, not marketing theatre.
      </h2>

      <p class="rh-section-lead">
        RelayHub should be judged by the same standards it applies to other
        technologies. Claims should be specific, testable, current, and honest
        about limitations.
      </p>

      <div class="rh-grid rh-grid-2" style="margin-top: var(--space-10);">
        {principles.map((item) => (
          <article class="rh-card">
            <h3 class="rh-card-title">{item.title}</h3>
            <p class="rh-card-text">{item.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="rh-section rh-bg-soft">
    <div class="rh-container">
      <p class="rh-kicker">A complementary ecosystem</p>

      <h2 class="rh-section-title">
        Resilience comes from useful options.
      </h2>

      <p class="rh-section-lead">
        Meshtastic or MeshCore may be right for a LoRa mesh. LoRaWAN may be the
        right choice for low-power telemetry and sensors. Amateur radio may be
        right for qualified operators who need broader radio capabilities.
        Satellite may be right beyond terrestrial coverage. Cellular push-to-talk
        may be ideal while carrier infrastructure is available. Sideband or Nomad
        Network may already solve the communication needs of Reticulum users.
        Signal may be ideal for mature private internet messaging, while Session
        offers a decentralised messaging architecture without phone-number
        registration.
      </p>

      <p class="rh-section-lead">
        RelayHub's role is to provide understandable, locally controlled,
        recoverable infrastructure across changing conditions — not to pretend
        every other technology should disappear.
      </p>

      <div class="rh-actions">
        <a class="rh-button rh-button-primary" href="/early-access">
          Register interest
        </a>

        <a class="rh-button rh-button-secondary" href="/faq">
          Read the FAQ
        </a>
      </div>
    </div>
  </section>
</BaseLayout>