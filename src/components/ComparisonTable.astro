---
interface ComparisonRow {
  area: string;
  left: string;
  right: string;
}

interface Props {
  leftHeading: string;
  rightHeading?: string;
  rows: ComparisonRow[];
}

const {
  leftHeading,
  rightHeading = "RelayHub",
  rows,
} = Astro.props;
---

<div
  style="
    margin-top: var(--space-10);
    overflow-x: auto;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-2xl);
    background: var(--rh-white);
  "
>
  <table
    style="
      width: 100%;
      min-width: 760px;
      border-collapse: collapse;
      text-align: left;
    "
  >
    <thead>
      <tr>
        <th
          scope="col"
          style="
            padding: var(--space-5);
            border-bottom: 1px solid var(--color-border);
          "
        >
          Area
        </th>

        <th
          scope="col"
          style="
            padding: var(--space-5);
            border-bottom: 1px solid var(--color-border);
          "
        >
          {leftHeading}
        </th>

        <th
          scope="col"
          style="
            padding: var(--space-5);
            border-bottom: 1px solid var(--color-border);
          "
        >
          {rightHeading}
        </th>
      </tr>
    </thead>

    <tbody>
      {rows.map((item) => (
        <tr>
          <th
            scope="row"
            style="
              padding: var(--space-5);
              border-bottom: 1px solid var(--color-border);
              vertical-align: top;
            "
          >
            {item.area}
          </th>

          <td
            style="
              padding: var(--space-5);
              border-bottom: 1px solid var(--color-border);
              color: var(--color-text-muted);
              line-height: 1.7;
              vertical-align: top;
            "
          >
            {item.left}
          </td>

          <td
            style="
              padding: var(--space-5);
              border-bottom: 1px solid var(--color-border);
              color: var(--color-text-muted);
              line-height: 1.7;
              vertical-align: top;
            "
          >
            {item.right}
          </td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
